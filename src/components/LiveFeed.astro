---
// Live printer camera, self-hosted: go2rtc on brainpi behind a Cloudflare Tunnel.
// site.json → live: { kind: 'go2rtc', url: 'https://live.embry.dev', src: 'p2s' }.
// Uses go2rtc's <video-stream> element (MSE over WebSocket, MP4 fallback), which works through the tunnel.
// The idle panel shows until the video actually plays; if nothing plays within 15 s it retries every 30 s.
import site from '../data/site.json';
const live = site.live ?? { kind: 'off' };
const ready = live.kind === 'go2rtc' && live.url;
const base = ready ? live.url.replace(/\/$/, '') : '';
const wsBase = base.replace(/^http/, 'ws');
---
<div class="live" data-live-kind={ready ? 'go2rtc' : 'off'} data-src={ready ? `${wsBase}/api/ws?src=${live.src}` : ''}>
  <div class="live-frame">
    {ready && <div class="live-player"></div>}
    <div class="live-offline">
      <p class="eyebrow">{ready ? 'Printer idle' : 'Camera not connected yet'}</p>
      <p>{ready ? 'The camera comes on when the printer is awake. Check back, or ' : 'The live feed is being wired up. Meanwhile, '}<a href="/prints">browse finished prints</a>.</p>
    </div>
    <p class="live-badge" hidden><span class="live-dot"></span> LIVE</p>
  </div>
</div>
{ready && <script type="module" src="/vendor/video-stream.js" is:inline></script>}
<script>
  const root = document.querySelector('.live[data-live-kind="go2rtc"]');
  if (root) {
    const src = root.dataset.src;
    const player = root.querySelector('.live-player');
    const panel = root.querySelector('.live-offline');
    const badge = root.querySelector('.live-badge');
    let el = null, watchdog = 0, retry = 0;
    const setLive = (on) => { panel.hidden = on; badge.hidden = !on; player.style.opacity = on ? '1' : '0'; };
    const teardown = () => { clearTimeout(watchdog); if (el) { el.remove(); el = null; } };
    const connect = () => {
      teardown();
      if (!customElements.get('video-stream')) { retry = setTimeout(connect, 1500); return; }
      el = document.createElement('video-stream');
      el.setAttribute('mode', 'mse,mp4');
      el.setAttribute('src', src);
      player.appendChild(el);
      const video = () => el.querySelector('video') ?? el.video;
      const check = () => {
        const v = video();
        if (v) { v.muted = true; v.setAttribute('playsinline', ''); v.addEventListener('playing', () => { clearTimeout(watchdog); setLive(true); }, { once: true }); }
      };
      setTimeout(check, 500); setTimeout(check, 2000);
      watchdog = setTimeout(() => { const v = video(); if (!v || v.readyState < 3) { setLive(false); teardown(); retry = setTimeout(connect, 30000); } }, 15000);
    };
    setLive(false);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { clearTimeout(retry); teardown(); setLive(false); } else connect(); });
    connect();
  }
</script>
