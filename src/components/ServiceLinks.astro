---
// "Other services" strip at the foot of each service page.
const { current } = Astro.props;
const all = [
  ['/knowledge-assistants', 'Knowledge assistants for small practices'],
  ['/software', 'Custom software for any business'],
  ['/printing', 'Design and 3D printing'],
];
const others = all.filter(([href]) => href !== current);
---
<section class="section band">
  <div class="wrap">
    <h2>Other things I build</h2>
    <div class="grid">
      {others.map(([href, label]) => <div class="card"><h3><a href={href}>{label}</a></h3></div>)}
    </div>
    <p class="muted"><a href="/services">All services on one page</a></p>
  </div>
</section>
