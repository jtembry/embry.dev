---
// Embry Development mark: an "E" of three stacked slabs (print layers), middle slab in copper.
// Colors come from CSS: .logo-ink and .logo-accent, so the mark adapts to light and dark bands.
const { class: className = '', size = 28, title = 'Embry Development' } = Astro.props;
---
<svg class={`logo ${className}`} width={size} height={size} viewBox="0 0 24 24" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <rect class="logo-ink" x="3" y="3.5" width="18" height="4.2" rx="1" />
  <rect class="logo-accent" x="3" y="9.9" width="12.5" height="4.2" rx="1" />
  <rect class="logo-ink" x="3" y="16.3" width="18" height="4.2" rx="1" />
</svg>
