---
// Finished prints, newest first. Entries come from brain-prints-publish (docs/live-and-gallery.md).
// The shop page passes featuredOnly. The archive lists every entry.
import { getCollection } from 'astro:content';
// Filament and time per print, exported from the prints database on brainpi (3d_printing/db/export_site.py).
import stats from '../data/print_stats.json';
const { featuredOnly = false } = Astro.props;
const prints = (await getCollection('prints'))
  .filter((p) => !featuredOnly || p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
  {prints.length === 0 ? (
    <div class="card">
      {featuredOnly ? (
        <p>Featured pieces will show here. Every finished print is in the <a href="/printing/archive">archive</a>.</p>
      ) : (
        <><p class="eyebrow">Filling in</p><p>The archive fills in as prints finish.</p></>
      )}
    </div>
  ) : (
    <div class="gallery">
      {prints.map((p) => (
        <article class="print card" class:list={{ featured: p.data.featured }}>
          <a class="print-media" href={p.data.video ?? p.data.image} aria-label={`Open ${p.data.title}`}>
            <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
            {p.data.video && <span class="print-play" aria-hidden="true">▶ timelapse</span>}
          </a>
          {p.data.moreImages.length > 0 && (
            <div class="print-thumbs">
              {p.data.moreImages.map((m) => <a href={m.src} aria-label={`Open ${m.alt}`}><img src={m.src} alt={m.alt} loading="lazy" decoding="async" /></a>)}
            </div>
          )}
          <div class="print-body">
            <h3>{p.data.title}</h3>
            <p class="muted">{fmt(p.data.date)}{p.data.material && ` · ${p.data.material}`}{p.data.color && ` · ${p.data.color}`}{p.data.printTime && ` · ${p.data.printTime}`}{p.data.layers && ` · ${p.data.layers} layers`}{p.data.nozzle && ` · ${p.data.nozzle} mm nozzle`}{stats.prints[p.id]?.grams && ` · ${Math.round(stats.prints[p.id].grams)} g of filament`}</p>
            {p.data.price && <p class="print-price">{p.data.price}</p>}
            {p.data.buyUrl && <p><a class="btn btn-primary" href={p.data.buyUrl} rel="noopener">Order now · pay by card</a></p>}
            {p.body && <p class="print-notes" set:html={p.rendered?.html ?? ''} />}
            <p class="print-meta">
              {p.data.designedByMe ? <span class="tag">My design</span> : p.data.model && <a class="tag" href={p.data.model}>Model</a>}
              {p.data.tags.map((t) => <span class="tag">{t}</span>)}
            </p>
          </div>
        </article>
      ))}
    </div>
  )}
