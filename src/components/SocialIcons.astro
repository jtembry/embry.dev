---
// Brand marks for the footer; fill follows the link color.
import site from '../data/site.json';
import { paths } from '../lib/brand-icons.js';
const { size = 20 } = Astro.props;
const icons = [
  [site.linkedin, 'LinkedIn', paths.linkedin],
  [site.github, 'GitHub', paths.github],
  [site.youtube, 'YouTube', paths.youtube],
];
---
<span class="social">
  {icons.map(([href, label, d]) => (
    <a href={href} rel="me" aria-label={label} title={label}>
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d={d} fill="currentColor" /></svg>
    </a>
  ))}
</span>
