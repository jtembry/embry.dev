---
// One box from the system map, written as a card for a narrow screen.
const { card } = Astro.props;
const { anchor, kind, title, technology, description, titleHref, relations } = card;
---
<article class:list={['map-card', `k-${kind}`]} id={anchor}>
  <h3>
    {titleHref ? <a href={titleHref}>{title} <span aria-hidden="true">→</span></a> : title}
  </h3>
  {technology && <p class="map-tech">{technology}</p>}
  {description && <p class="map-desc">{description}</p>}
  {relations.length > 0 && (
    <ul class="map-rels">
      {relations.map((rel) => (
        <li>
          <span class="map-rel-label">{rel.label}</span>
          <a href={rel.href}><span aria-hidden="true">→ </span>{rel.title}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .map-card { scroll-margin-top: 5.5rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: .95rem 1rem 1rem; }
  .map-card h3 { margin: 0; font-size: 1.2rem; line-height: 1.25; }
  .map-card h3 a { color: var(--accent); text-decoration: none; display: inline-block; padding: .15rem 0; }
  .map-card h3 a:hover { color: var(--accent-bright); }
  .map-tech { margin: .25rem 0 0; font-family: var(--mono); font-size: .8rem; line-height: 1.4; color: var(--accent); }
  .map-desc { margin: .4rem 0 0; color: var(--ink-2); }
  .map-rels { list-style: none; margin: .75rem 0 0; padding: .65rem 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: .4rem; }
  .map-rels li { display: flex; flex-wrap: wrap; gap: .15rem .4rem; align-items: baseline; margin: 0; }
  .map-rel-label { color: var(--muted); }
  .map-rels a { font-weight: 600; white-space: nowrap; }
  .map-card.k-person { background: var(--accent-tint); border-color: var(--accent-bright); }
  .map-card.k-service { border-style: dashed; }
  .map-card.k-device { box-shadow: inset 4px 0 0 var(--ink-2); }
</style>
