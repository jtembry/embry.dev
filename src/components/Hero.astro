---
// Page hero. A blueprint dot grid and a generated pattern behind the text. `tall` makes it a
// full-height opener. The big button (mapLabel) opens the four-step overview at /map, or mapTo.
import { patterns } from '../lib/patterns.js';
const { eyebrow, title, variant = 'graph', seed = 3, image, tall = false, mapLabel, mapTo } = Astro.props;
const mapHref = mapTo ?? '/map';
const gen = patterns[variant] ?? patterns.graph;
const back = patterns.dots();
const front = gen({ parity: 0, seed }) + gen({ parity: 1, seed });
---
<section class:list={['hero', 'band-dark', `hero-${variant}`, { 'hero-tall': tall }]}>
  <div class="hero-bg" aria-hidden="true">
    {image && <img class="hero-img" src={image} alt="" loading="eager" decoding="async" />}
    <div class="hero-layer hero-layer-back" set:html={back} />
    {front && <div class="hero-layer hero-layer-front" set:html={front} />}
    <div class="hero-glow"></div>
  </div>
  <div class="wrap hero-content">
    <div class="hero-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <slot />
      {(mapLabel || Astro.slots.has('actions')) && (
        <p class="hero-actions">
          {mapLabel && mapHref && <a class="btn btn-primary" href={mapHref}>{mapLabel} <span aria-hidden="true">→</span></a>}
          <slot name="actions" />
        </p>
      )}
    </div>
  </div>
</section>
