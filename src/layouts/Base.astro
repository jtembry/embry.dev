---
import '../styles/global.css';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/', 'Home'],
  ['/services', 'Services'],
  ['/printing', '3D printing'],
  ['/work', 'Work'],
  ['/about', 'About'],
  ['/contact', 'Contact'],
];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.legalName}</title>
    <meta name="description" content={description ?? site.tagline} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/"><Logo size={26} /> embry<span>.dev</span></a>
        <nav class="primary" aria-label="Primary">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-primary" href={mailto}>Start a conversation</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p class="footer-brand"><Logo class="logo-footer" size={32} /><br />{site.legalName}<br /><em>{site.tagline}</em></p>
        <p>{site.ownerName} · {site.location}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin} rel="me">LinkedIn</a> · <a href={site.github} rel="me">GitHub</a></p>
        <p class="muted">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
