---
import '../styles/global.css';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
import SocialIcons from '../components/SocialIcons.astro';
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const services = [
  ['/knowledge-assistants', 'Knowledge assistants'],
  ['/software', 'Custom software'],
  ['/printing', '3D printing'],
];
const more = [
  ['/about', 'About'],
];
const nav = [...services, ...more];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.legalName}</title>
    <meta name="description" content={description ?? site.tagline} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/" aria-label="Embry Development home"><Logo size={24} /><span class="brand-text">embry<span class="dot">.dev</span></span></a>
        <nav class="primary" aria-label="Primary">
          <ul>{nav.map(([href, label]) => <li><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
          <a class="btn btn-primary nav-cta" href={mailto}>Email me</a>
        </nav>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open menu">
          <span class="bar-line"></span><span class="bar-line"></span>
        </button>
      </div>
    </header>
    <div class="nav-backdrop"></div>
    <aside id="site-drawer" class="drawer" aria-label="Menu">
      <div class="drawer-head">
        <a class="brand" href="/"><Logo size={24} /><span class="brand-text">embry<span class="dot">.dev</span></span></a>
        <button class="drawer-close" type="button" aria-label="Close menu">×</button>
      </div>
      <p class="drawer-label" style="--i:0">What I build</p>
      <ul class="drawer-list">{services.map(([href, label], i) => <li style={`--i:${i + 1}`}><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
      <p class="drawer-label" style="--i:5">More</p>
      <ul class="drawer-list">{more.map(([href, label], i) => <li style={`--i:${i + 6}`}><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
      <a class="btn btn-primary drawer-cta" href={mailto} style="--i:9">Email me</a>
      <p class="drawer-foot" style="--i:10">{site.legalName} · {site.location}</p>
    </aside>
    <main id="main">
      <slot />
    </main>
    <dialog class="contact-dialog" aria-labelledby="contact-title">
      <form class="contact-form" method="post" action={site.contactEndpoint} data-fallback={site.email}>
        <div class="contact-head">
          <h2 id="contact-title">Send me a message</h2>
          <button type="button" class="contact-close" aria-label="Close">×</button>
        </div>
        <p class="muted">I read everything and reply within two business days.</p>
        <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
        <label>Your email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
        <label>Message<textarea name="message" rows="7" required maxlength="10000"></textarea></label>
        <label class="contact-hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <input type="hidden" name="subject" />
        <input type="hidden" name="page" />
        <p class="contact-status" role="status" aria-live="polite"></p>
        <p class="contact-actions"><button class="btn btn-primary" type="submit">Send message</button></p>
      </form>
    </dialog>
    <footer class="site">
      <div class="wrap">
        <p class="footer-brand"><Logo class="logo-footer" size={32} /><br />{site.legalName}<br /><em>{site.tagline}</em></p>
        <p>{site.ownerName} <SocialIcons /><br />
          {site.location} · <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href="/printing#live">Live from the printer</a> · <a href="/printing#prints">Print gallery</a> · <a href="/services">Services</a></p>
        <p class="muted">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const closeBtn = document.querySelector('.drawer-close');
      const setOpen = (open) => {
        root.toggleAttribute('data-nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      toggle.addEventListener('click', () => setOpen(!root.hasAttribute('data-nav-open')));
      if (location.hash === '#menu') setOpen(true);
      backdrop.addEventListener('click', () => setOpen(false));
      closeBtn.addEventListener('click', () => setOpen(false));
      document.querySelectorAll('.drawer a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      window.matchMedia('(min-width: 66rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

      // Contact: every mailto link on the site opens the on-screen form instead (the link
      // stays as the no-JS fallback). Subject and body from the link prefill the form.
      const contact = document.querySelector<HTMLDialogElement>('dialog.contact-dialog');
      const contactForm = contact?.querySelector('form');
      if (contact && contactForm) {
        const status = contactForm.querySelector<HTMLElement>('.contact-status')!;
        const submit = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const field = (n: string) => contactForm.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
        document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            setOpen(false);
            const params = new URL(a.href).searchParams;
            field('subject').value = params.get('subject') ?? 'Project inquiry';
            field('page').value = location.pathname;
            if (!field('message').value && params.get('body')) field('message').value = params.get('body')!;
            status.textContent = '';
            contactForm.hidden = false;
            contact.showModal();
            field('name').focus();
          });
        });
        contact.querySelector('.contact-close')!.addEventListener('click', () => contact.close());
        contact.addEventListener('click', (e) => { if (e.target === contact) contact.close(); });
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!contactForm.reportValidity()) return;
          submit.disabled = true;
          status.textContent = 'Sending…';
          try {
            const res = await fetch(contactForm.action, { method: 'POST', body: new FormData(contactForm) });
            const out = await res.json().catch(() => ({}));
            if (!res.ok || !out.ok) throw new Error(out.error || 'Could not send right now.');
            contactForm.reset();
            status.textContent = "Sent. Thank you, I'll reply within two business days.";
          } catch (err) {
            status.textContent = `${(err as Error).message} You can also write to ${contactForm.dataset.fallback}.`;
          } finally {
            submit.disabled = false;
          }
        });
      }

      // Parallax: only the hero's system map moves, on an eased scroll value,
      // relative to its section's center. Text and page bands stay put.
      const motion = root.classList.contains('motion');
      const layers = Array.from(document.querySelectorAll('[data-parallax]'));
      if (motion && layers.length) {
        let target = window.scrollY, current = target, raf = 0;
        const apply = (y) => {
          const mid = window.innerHeight / 2;
          const real = window.scrollY;
          for (const el of layers) {
            const host = el.closest('.hero, .band-parallax') ?? el;
            const r = host.getBoundingClientRect();
            const centerDoc = r.top + real + r.height / 2;
            const offset = (y + mid - centerDoc) * parseFloat(el.dataset.parallax);
            el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
          }
        };
        const tick = () => {
          current += (target - current) * 0.11;
          if (Math.abs(target - current) < 0.25) { current = target; apply(current); raf = 0; return; }
          apply(current); raf = requestAnimationFrame(tick);
        };
        const onScroll = () => { target = window.scrollY; if (!raf) raf = requestAnimationFrame(tick); };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => apply(current));
        apply(current);
      }
    </script>
    {import.meta.env.PROD && site.cfAnalyticsToken && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>}
  </body>
</html>
