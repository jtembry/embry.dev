---
import '../styles/global.css';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
import SocialIcons from '../components/SocialIcons.astro';
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const services = [
  ['/knowledge-assistants', 'AI systems'],
  ['/software', 'Software solutions'],
  ['/printing', '3D printing'],
];
const more = [
  ['/products', 'Products'],
  ['/about', 'About'],
];
const nav = [...services, ...more];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.legalName}</title>
    <meta name="description" content={description ?? site.tagline} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
    <script is:inline>try { if (localStorage.getItem('embry-look') === 'dos') { document.documentElement.dataset.look = 'dos'; var icon = document.querySelector('link[rel="icon"]'); if (icon) icon.href = '/favicon-dos.svg'; } } catch {}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/" aria-label="Embry Development home"><Logo size={24} /><span class="brand-text">embry<span class="dot">.dev</span></span></a>
        <nav class="primary" aria-label="Primary">
          <ul>{nav.map(([href, label]) => <li><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
          <button class="look-toggle" type="button" role="switch" aria-checked="false" aria-label="Green screen look" title="Green screen look"><span class="look-knob" aria-hidden="true"></span></button>
          <a class="btn btn-primary nav-cta" href={mailto}>Email me</a>
        </nav>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open menu">
          <span class="bar-line"></span><span class="bar-line"></span>
        </button>
      </div>
    </header>
    <div class="nav-backdrop"></div>
    <aside id="site-drawer" class="drawer" aria-label="Menu">
      <div class="drawer-head">
        <a class="brand" href="/"><Logo size={24} /><span class="brand-text">embry<span class="dot">.dev</span></span></a>
        <button class="drawer-close" type="button" aria-label="Close menu">×</button>
      </div>
      <p class="drawer-label" style="--i:0">What I build</p>
      <ul class="drawer-list">{services.map(([href, label], i) => <li style={`--i:${i + 1}`}><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
      <p class="drawer-label" style="--i:5">More</p>
      <ul class="drawer-list">{more.map(([href, label], i) => <li style={`--i:${i + 6}`}><a href={href} aria-current={path === href || path.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}</ul>
      <div class="drawer-look" style="--i:9"><button class="look-toggle" type="button" role="switch" aria-checked="false" aria-label="Green screen look" title="Green screen look"><span class="look-knob" aria-hidden="true"></span></button></div>
      <a class="btn btn-primary drawer-cta" href={mailto} style="--i:10">Email me</a>
      <p class="drawer-foot" style="--i:11">{site.legalName} · {site.location}</p>
    </aside>
    <main id="main">
      <slot />
    </main>
    <dialog class="contact-dialog" aria-labelledby="contact-title">
      <form class="contact-form" method="post" action={site.contactEndpoint} data-fallback={site.email}>
        <div class="contact-head">
          <h2 id="contact-title">Send me a message</h2>
          <button type="button" class="contact-close" aria-label="Close">×</button>
        </div>
        <p class="muted">I read everything and reply within two business days.</p>
        <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
        <label>Your email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
        <label>Message<textarea name="message" rows="7" required maxlength="10000"></textarea></label>
        <label class="contact-hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <input type="hidden" name="subject" />
        <input type="hidden" name="page" />
        <p class="contact-status" role="status" aria-live="polite"></p>
        <p class="contact-actions"><button class="btn btn-primary" type="submit">Send message</button></p>
      </form>
    </dialog>
    {site.booking && (
      <dialog class="contact-dialog" id="book-dialog" aria-labelledby="book-title">
        <form class="contact-form" method="post" action={site.contactEndpoint} data-fallback={site.email} data-booking={JSON.stringify(site.booking)}>
          <div class="contact-head">
            <h2 id="book-title">Book a free consultation</h2>
            <button type="button" class="contact-close" aria-label="Close">×</button>
          </div>
          <p class="muted">A 15-minute phone call. I call you. I confirm within two business days.</p>
          <p class="muted">{site.booking.hoursLabel}</p>
          <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
          <label>Your email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
          <label>What do you want to talk about?<input name="topic" required maxlength="200" /></label>
          <div class="book-cal">
            <div class="book-cal-bar">
              <button type="button" class="book-cal-nav" data-cal-prev aria-label="Previous month">‹</button>
              <p class="book-cal-month" data-cal-month></p>
              <button type="button" class="book-cal-nav" data-cal-next aria-label="Next month">›</button>
            </div>
            <div class="book-cal-grid" data-cal-grid></div>
            <p class="book-cal-empty" data-cal-empty hidden>No open times in the next three weeks.</p>
            <div class="book-times" data-book-times hidden>
              <p class="book-times-label" data-times-label></p>
              <div class="book-times-list" data-times-list role="group" aria-label="Times"></div>
            </div>
          </div>
          <input type="hidden" name="slot" value="" />
          <label class="contact-hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
          <input type="hidden" name="subject" value="Free consultation" />
          <input type="hidden" name="page" />
          <input type="hidden" name="message" />
          <input type="hidden" name="slotStart" />
          <input type="hidden" name="slotEnd" />
          <p class="contact-status" role="status" aria-live="polite"></p>
          <p class="contact-actions"><button class="btn btn-primary" type="submit">Request this time</button></p>
        </form>
      </dialog>
    )}
    <footer class="site">
      <div class="wrap">
        <p class="footer-brand"><Logo class="logo-footer" size={32} /><br />{site.legalName}<br /><em>{site.tagline}</em></p>
        <p>{site.ownerName} <SocialIcons /><br />
          {site.location} · <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href="/printing#live">Live from the printer</a> · <a href="/printing#prints">Featured prints</a> · <a href="/printing/archive">Print archive</a> · <a href="/services">Services</a></p>
        <p class="muted">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const closeBtn = document.querySelector('.drawer-close');
      const setOpen = (open) => {
        root.toggleAttribute('data-nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      toggle.addEventListener('click', () => setOpen(!root.hasAttribute('data-nav-open')));
      if (location.hash === '#menu') setOpen(true);
      backdrop.addEventListener('click', () => setOpen(false));
      closeBtn.addEventListener('click', () => setOpen(false));
      document.querySelectorAll('.drawer a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      // Look: DOS mode (green phosphor, like the FieldADE app) or the normal site. The head
      // script applies a saved choice before paint; screenshots swap via .look-dos-only/.look-pro-only.
      const lookButtons = document.querySelectorAll('.look-toggle');
      const icon = document.querySelector('link[rel="icon"]');
      const showLook = () => {
        const dos = root.dataset.look === 'dos';
        lookButtons.forEach((b) => b.setAttribute('aria-checked', String(dos)));
        if (icon) icon.href = dos ? '/favicon-dos.svg' : '/favicon.svg';
      };
      lookButtons.forEach((b) => b.addEventListener('click', () => {
        const dos = root.dataset.look !== 'dos';
        if (dos) root.dataset.look = 'dos'; else delete root.dataset.look;
        try { localStorage.setItem('embry-look', dos ? 'dos' : 'pro'); } catch {}
        showLook();
      }));
      showLook();
      window.matchMedia('(min-width: 66rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

      // Contact: every mailto link on the site opens the on-screen form instead (the link
      // stays as the no-JS fallback). Subject and body from the link prefill the form.
      const contact = document.querySelector<HTMLDialogElement>('dialog.contact-dialog');
      const contactForm = contact?.querySelector('form');
      if (contact && contactForm) {
        const status = contactForm.querySelector<HTMLElement>('.contact-status')!;
        const submit = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const field = (n: string) => contactForm.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
        document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            setOpen(false);
            const params = new URL(a.href).searchParams;
            field('subject').value = params.get('subject') ?? 'Project inquiry';
            field('page').value = location.pathname;
            if (!field('message').value && params.get('body')) field('message').value = params.get('body')!;
            status.textContent = '';
            contactForm.hidden = false;
            contact.showModal();
            field('name').focus();
          });
        });
        contact.querySelector('.contact-close')!.addEventListener('click', () => contact.close());
        contact.addEventListener('click', (e) => { if (e.target === contact) contact.close(); });
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!contactForm.reportValidity()) return;
          submit.disabled = true;
          status.textContent = 'Sending…';
          try {
            const res = await fetch(contactForm.action, { method: 'POST', body: new FormData(contactForm) });
            const out = await res.json().catch(() => ({}));
            if (!res.ok || !out.ok) throw new Error(out.error || 'Could not send right now.');
            contactForm.reset();
            status.textContent = "Sent. Thank you, I'll reply within two business days.";
          } catch (err) {
            status.textContent = `${(err as Error).message} You can also write to ${contactForm.dataset.fallback}.`;
          } finally {
            submit.disabled = false;
          }
        });
      }

      // Consultation: the homepage tile opens this dialog. The request is emailed.
      // A calendar file is attached only after the contact worker that knows
      // slotStart/slotEnd is deployed. weekday 0 is Sunday.
      const book = document.querySelector<HTMLDialogElement>('#book-dialog');
      const bookForm = book?.querySelector('form');
      const bookCfg = bookForm?.dataset.booking ? JSON.parse(bookForm.dataset.booking) : null;
      if (book && bookForm && bookCfg) {
        const bookStatus = bookForm.querySelector<HTMLElement>('.contact-status')!;
        const bookSubmit = bookForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const bookField = (n: string) => bookForm.elements.namedItem(n) as HTMLInputElement;
        const slotInput = bookField('slot');
        const cal = bookForm.querySelector('.book-cal')!;
        const grid = cal.querySelector<HTMLElement>('[data-cal-grid]')!;
        const monthLabel = cal.querySelector<HTMLElement>('[data-cal-month]')!;
        const prevBtn = cal.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
        const nextBtn = cal.querySelector<HTMLButtonElement>('[data-cal-next]')!;
        const timesWrap = cal.querySelector<HTMLElement>('[data-book-times]')!;
        const timesLabel = cal.querySelector<HTMLElement>('[data-times-label]')!;
        const timesList = cal.querySelector<HTMLElement>('[data-times-list]')!;
        const emptyNote = cal.querySelector<HTMLElement>('[data-cal-empty]')!;
        const zone = bookCfg.timezone as string;
        const duration = bookCfg.durationMinutes as number;
        const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const labelFmt = new Intl.DateTimeFormat('en-US', {
          timeZone: zone, weekday: 'long', month: 'long', day: 'numeric',
          hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
        });
        const endFmt = new Intl.DateTimeFormat('en-US', {
          timeZone: zone, hour: 'numeric', minute: '2-digit',
        });
        const dayFmt = new Intl.DateTimeFormat('en-US', {
          timeZone: zone, weekday: 'long', month: 'long', day: 'numeric',
        });
        const timeFmt = new Intl.DateTimeFormat('en-US', {
          timeZone: zone, hour: 'numeric', minute: '2-digit',
        });
        const monthFmt = new Intl.DateTimeFormat('en-US', {
          timeZone: zone, month: 'long', year: 'numeric',
        });
        const zoneParts = (date: Date) => {
          const bag: Record<string, string> = {};
          for (const p of new Intl.DateTimeFormat('en-US', {
            timeZone: zone, hourCycle: 'h23', weekday: 'short',
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit',
          }).formatToParts(date)) bag[p.type] = p.value;
          return bag;
        };
        // Wall-clock time in the booking zone, as a UTC instant.
        const atZone = (y: number, mo: number, d: number, hh: number, mm: number) => {
          const utc = new Date(Date.UTC(y, mo - 1, d, hh, mm));
          const p = zoneParts(utc);
          const asUTC = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute);
          return new Date(utc.getTime() - (asUTC - utc.getTime()));
        };
        const nextDay = (y: number, mo: number, d: number) => {
          const p = zoneParts(atZone(y, mo, d + 1, 12, 0));
          return [+p.year, +p.month, +p.day] as const;
        };
        const dayKey = (date: Date) => {
          const p = zoneParts(date);
          return `${p.year}-${p.month}-${p.day}`;
        };
        const shiftMonth = (y: number, m: number, delta: number) => {
          const moved = new Date(Date.UTC(y, m - 1 + delta, 1));
          return [moved.getUTCFullYear(), moved.getUTCMonth() + 1] as const;
        };
        let byDay = new Map<string, Date[]>();
        let viewY = 0;
        let viewM = 0;
        let selectedKey = '';
        const monthHas = (y: number, m: number) => {
          const prefix = `${y}-${String(m).padStart(2, '0')}-`;
          for (const key of byDay.keys()) if (key.startsWith(prefix)) return true;
          return false;
        };
        const renderTimes = (key: string) => {
          timesList.replaceChildren();
          const daySlots = byDay.get(key) ?? [];
          if (!daySlots.length) { timesWrap.hidden = true; return; }
          timesWrap.hidden = false;
          timesLabel.textContent = dayFmt.format(daySlots[0]);
          for (const start of daySlots) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'book-time';
            b.textContent = timeFmt.format(start);
            const endIso = new Date(start.getTime() + duration * 60000).toISOString();
            b.setAttribute('aria-pressed', slotInput.value === start.toISOString() ? 'true' : 'false');
            b.addEventListener('click', () => {
              slotInput.value = start.toISOString();
              bookField('slotEnd').value = endIso;
              timesList.querySelectorAll('.book-time').forEach((el) => el.setAttribute('aria-pressed', 'false'));
              b.setAttribute('aria-pressed', 'true');
            });
            timesList.append(b);
          }
        };
        const renderMonth = () => {
          grid.replaceChildren();
          for (const name of ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']) {
            const s = document.createElement('span');
            s.className = 'book-cal-dow';
            s.textContent = name;
            grid.append(s);
          }
          const firstWd = weekdays.indexOf(zoneParts(atZone(viewY, viewM, 1, 12, 0)).weekday);
          for (let i = 0; i < firstWd; i++) {
            const s = document.createElement('span');
            s.className = 'book-cal-pad';
            grid.append(s);
          }
          let day = 1;
          while (day <= 31 && zoneParts(atZone(viewY, viewM, day, 12, 0)).month === String(viewM).padStart(2, '0')) {
            const probe = atZone(viewY, viewM, day, 12, 0);
            const key = dayKey(probe);
            if (byDay.has(key)) {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'book-cal-day';
              b.textContent = String(day);
              b.setAttribute('aria-label', dayFmt.format(probe));
              b.setAttribute('aria-pressed', selectedKey === key ? 'true' : 'false');
              b.addEventListener('click', () => {
                selectedKey = key;
                slotInput.value = '';
                bookField('slotEnd').value = '';
                renderMonth();
                renderTimes(key);
              });
              grid.append(b);
            } else {
              const s = document.createElement('span');
              s.className = 'book-cal-day';
              s.textContent = String(day);
              grid.append(s);
            }
            day++;
          }
          monthLabel.textContent = monthFmt.format(atZone(viewY, viewM, 1, 12, 0));
          const [py, pm] = shiftMonth(viewY, viewM, -1);
          const [ny, nm] = shiftMonth(viewY, viewM, 1);
          prevBtn.disabled = !monthHas(py, pm);
          nextBtn.disabled = !monthHas(ny, nm);
          emptyNote.hidden = byDay.size > 0;
          bookSubmit.disabled = byDay.size === 0;
        };
        const showCalendar = () => {
          const slots: Date[] = [];
          const now = Date.now();
          const notice = (bookCfg.noticeHours as number) * 60 * 60 * 1000;
          const today = zoneParts(new Date());
          let y = +today.year, mo = +today.month, d = +today.day;
          for (let i = 0; i <= (bookCfg.horizonDays as number); i++) {
            const weekday = weekdays.indexOf(zoneParts(atZone(y, mo, d, 12, 0)).weekday);
            for (const w of bookCfg.windows as { weekday: number, start: string, end: string }[]) {
              if (w.weekday !== weekday) continue;
              const [eh, em] = w.end.split(':').map(Number);
              const endMins = eh * 60 + em;
              let mins = w.start.split(':').map(Number).reduce((h, m) => h * 60 + m);
              while (mins + duration <= endMins) {
                const start = atZone(y, mo, d, Math.floor(mins / 60), mins % 60);
                if (start.getTime() >= now + notice) slots.push(start);
                mins += duration;
              }
            }
            [y, mo, d] = nextDay(y, mo, d);
          }
          byDay = new Map();
          for (const start of slots) {
            const key = dayKey(start);
            byDay.set(key, [...(byDay.get(key) ?? []), start]);
          }
          selectedKey = '';
          slotInput.value = '';
          bookField('slotEnd').value = '';
          timesWrap.hidden = true;
          timesList.replaceChildren();
          const first = slots[0] ? zoneParts(slots[0]) : zoneParts(new Date());
          viewY = +first.year;
          viewM = +first.month;
          renderMonth();
        };
        prevBtn.addEventListener('click', () => {
          if (prevBtn.disabled) return;
          [viewY, viewM] = shiftMonth(viewY, viewM, -1);
          renderMonth();
        });
        nextBtn.addEventListener('click', () => {
          if (nextBtn.disabled) return;
          [viewY, viewM] = shiftMonth(viewY, viewM, 1);
          renderMonth();
        });
        document.querySelectorAll<HTMLButtonElement>('[data-book]').forEach((btn) => {
          btn.addEventListener('click', () => {
            setOpen(false);
            bookField('page').value = location.pathname;
            showCalendar();
            bookStatus.textContent = '';
            book.showModal();
            bookField('name').focus();
          });
        });
        book.querySelector('.contact-close')!.addEventListener('click', () => book.close());
        book.addEventListener('click', (e) => { if (e.target === book) book.close(); });
        bookForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!bookForm.reportValidity()) return;
          const phone = bookField('phone').value.trim();
          if ((phone.match(/\d/g) || []).length < 7) {
            bookStatus.textContent = 'Enter a phone number I can call.';
            return;
          }
          if (!slotInput.value || !bookField('slotEnd').value) {
            bookStatus.textContent = 'Pick a day and a time.';
            return;
          }
          const start = new Date(slotInput.value);
          const end = new Date(bookField('slotEnd').value);
          const topic = bookField('topic').value.trim();
          bookField('slotStart').value = start.toISOString();
          bookField('message').value = [
            'Free consultation request.',
            '',
            `When: ${labelFmt.format(start)} to ${endFmt.format(end)}`,
            `Phone: ${phone}`,
            `Topic: ${topic}`,
            '',
            'This is a request. Add it to the calendar only if you accept the call.',
          ].join('\n');
          bookSubmit.disabled = true;
          bookStatus.textContent = 'Sending…';
          try {
            const res = await fetch(bookForm.action, { method: 'POST', body: new FormData(bookForm) });
            const out = await res.json().catch(() => ({}));
            if (!res.ok || !out.ok) throw new Error(out.error || 'Could not send right now.');
            bookForm.reset();
            bookField('subject').value = 'Free consultation';
            showCalendar();
            bookStatus.textContent = "Sent. I'll email you within two business days. It is not booked until I confirm.";
          } catch (err) {
            bookStatus.textContent = `${(err as Error).message} You can also write to ${bookForm.dataset.fallback}.`;
          } finally {
            bookSubmit.disabled = byDay.size === 0;
          }
        });
      }

      // Parallax: only the hero's system map moves, on an eased scroll value,
      // relative to its section's center. Text and page bands stay put.
      const motion = root.classList.contains('motion');
      const layers = Array.from(document.querySelectorAll('[data-parallax]'));
      if (motion && layers.length) {
        let target = window.scrollY, current = target, raf = 0;
        const apply = (y) => {
          const mid = window.innerHeight / 2;
          const real = window.scrollY;
          for (const el of layers) {
            const host = el.closest('.hero, .band-parallax') ?? el;
            const r = host.getBoundingClientRect();
            const centerDoc = r.top + real + r.height / 2;
            const offset = (y + mid - centerDoc) * parseFloat(el.dataset.parallax);
            el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
          }
        };
        const tick = () => {
          current += (target - current) * 0.11;
          if (Math.abs(target - current) < 0.25) { current = target; apply(current); raf = 0; return; }
          apply(current); raf = requestAnimationFrame(tick);
        };
        const onScroll = () => { target = window.scrollY; if (!raf) raf = requestAnimationFrame(tick); };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => apply(current));
        apply(current);
      }
    </script>
