---
import '../styles/global.css';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/ai-adoption', 'AI adoption'],
  ['/knowledge-assistants', 'Knowledge assistants'],
  ['/websites', 'Websites'],
  ['/printing', '3D printing'],
  ['/work', 'Work'],
  ['/about', 'About'],
  ['/contact', 'Contact'],
];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.legalName}</title>
    <meta name="description" content={description ?? site.tagline} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Embry Development home"><Logo size={26} /><span class="brand-text">embry<span class="dot">.dev</span></span></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
          <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        </button>
        <nav id="site-nav" class="primary" aria-label="Primary">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
          <a class="btn btn-primary nav-cta" href={mailto}>Get in touch</a>
        </nav>
        <div class="nav-backdrop"></div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p class="footer-brand"><Logo class="logo-footer" size={32} /><br />{site.legalName}<br /><em>{site.tagline}</em></p>
        <p>{site.ownerName} · {site.location}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin} rel="me">LinkedIn</a> · <a href={site.github} rel="me">GitHub</a></p>
        <p class="muted">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const setOpen = (open) => {
        root.toggleAttribute('data-nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      toggle.addEventListener('click', () => setOpen(!root.hasAttribute('data-nav-open')));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      window.matchMedia('(min-width: 66rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });

      // Parallax: layers with data-parallax move at a fraction of scroll speed, relative to their section.
      const layers = Array.from(document.querySelectorAll('[data-parallax]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (layers.length && !reduceMotion.matches) {
        let ticking = false;
        const update = () => {
          const mid = window.innerHeight / 2;
          for (const el of layers) {
            const host = el.closest('.hero, .band-parallax') ?? el;
            const r = host.getBoundingClientRect();
            const offset = (r.top + r.height / 2 - mid) * -parseFloat(el.dataset.parallax);
            el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
