---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
---
<Base title="AI systems for offices" description="I build an AI system for your office. Client files stay on a computer you own, and I train your staff to use it.">
  <Hero variant="graph" tall eyebrow={`${site.legalName} · ${site.location}`} title="I'll build what your office needs.">
    <p class="lede">I build AI systems and software solutions for offices. Let AI do the busywork while you run the business.</p>
    {(site.calUrl || site.booking) && (
      <Fragment slot="actions">
        {site.calUrl
          ? <a class="btn btn-primary" href={site.calUrl} target="_blank" rel="noopener">Book a free consultation</a>
          : <button type="button" class="btn btn-primary" data-book>Book a free consultation</button>}
      </Fragment>
    )}
  </Hero>

  <section class="section" id="fieldade">
    <div class="wrap">
      <h2>Customizable solutions</h2>
      <div class="grid">
        <div class="card">
          <h3><a href="/homeade"><span class="wordmark">Home<span class="accent">ADE</span></span></a></h3>
          <p>Runs on a computer you own, in your office. It files what comes in, drafts replies, and gives your agents the information they need when they need it. <a href="/homeade">See HomeADE</a></p>
        </div>
        <div class="card">
          <h3><a href="/fieldade"><span class="wordmark">Field<span class="accent">ADE</span></span></a></h3>
          <p>An iPhone app. It shows your priorities and lets you reach the whole office through a chat. <a href="/fieldade">See FieldADE</a></p>
        </div>
        <div class="card">
          <h3>Mission support</h3>
          <p>I train your staff with demos and answer their questions as they work. As your business changes, I change the app to fit.</p>
        </div>
      </div>
      <div class="card card-wide">
        <h3>Built to order</h3>
        <p>If the piece you need is missing, I build it: custom software made around the way you work. <a href="/software">See custom builds</a></p>
      </div>
      <p><a class="btn btn-primary btn-lg" href="/map">See the system map</a></p>
    </div>
  </section>
</Base>
