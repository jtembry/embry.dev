---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
---
<Base title="AI systems for offices" description="I build what your office needs from the Claude or ChatGPT account you already pay for. Client files stay on a computer you own, and I train your staff to use it.">
  <Hero variant="graph" tall eyebrow={`${site.legalName} · ${site.location}`} title="I'll build what your office needs.">
    <p class="lede">I build AI systems and custom software solutions for offices. Let AI focus on the busywork so you can focus on your business.</p>
    {(site.calUrl || site.booking) && (
      <Fragment slot="actions">
        {site.calUrl
          ? <a class="btn btn-primary" href={site.calUrl} target="_blank" rel="noopener">Book a free consultation</a>
          : <button type="button" class="btn btn-primary" data-book>Book a free consultation</button>}
      </Fragment>
    )}
  </Hero>

  <section class="section" id="fieldade">
    <div class="wrap">
      <h2>Customizable solutions</h2>
      <div class="grid">
        <div class="card">
          <h3><span class="wordmark">Home<span class="accent"> base</span></span></h3>
          <p>Runs on a computer at your office that you own. It files what comes in, drafts replies, and quickly gives your agents the information they need, when you need it.</p>
        </div>
        <div class="card">
          <h3><span class="wordmark">Field<span class="accent"> Agent</span></span></h3>
          <p>On iOS and Android. It shows your priorities and puts the whole office at your fingertips through a chat.</p>
        </div>
        <div class="card">
          <h3>Mission support</h3>
          <p>I train your staff with demos and give them real-time support. As your business changes, I enhance the app to meet your needs.</p>
        </div>
      </div>
      <div class="card card-wide">
        <h3>Built to order</h3>
        <p>If the piece you need does not exist, I build it: custom software made around the way you work. <a href="/software">See custom software</a></p>
      </div>
      <p><a class="btn btn-primary btn-lg" href="/map">See the system map</a></p>
    </div>
  </section>
</Base>
