---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { dots } from '../lib/patterns.js';
const stepsBg = dots();
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="AI systems for small offices" description="I build what your office needs from the Claude or ChatGPT account you already pay for. Client files stay on a computer you own, and I train your staff to use it.">
  <Hero variant="graph" tall eyebrow={`${site.legalName} · ${site.location}`} title="I'll build what your office needs.">
    <p class="lede">I build AI systems for small offices. They do the paperwork, so you can do the work.</p>
    {site.booking && (
      <Fragment slot="actions">
        <button type="button" class="btn btn-primary" data-book>Book a free consultation</button>
      </Fragment>
    )}
  </Hero>

  <section class="section" id="field-agent">
    <div class="wrap">
      <h2>What you get</h2>
      <div class="grid">
        <div class="card">
          <h3><span class="wordmark">Home base</span></h3>
          <p>Runs at your office on a computer you own. It files what comes in, drafts the replies, and answers from your own documents.</p>
        </div>
        <div class="card">
          <h3><span class="wordmark">Field Agent</span></h3>
          <p>The phone app. It shows what needs you today and asks before it changes anything.</p>
        </div>
        <div class="card">
          <h3>Training</h3>
          <p>Four weeks beside your staff, on their real work.</p>
        </div>
      </div>
      <p><a href="/knowledge-assistants">What you get, in full</a> · <a href="/map">See the system map</a></p>
    </div>
  </section>

  <section class="section band-parallax">
    <div class="band-bg" set:html={stepsBg} aria-hidden="true" />
    <div class="wrap">
      <h2>How we help</h2>
      <ol class="steps">
        <li><strong>Tell me the problem.</strong> One email is enough.</li>
        <li><strong>Get a one-page scope.</strong> What you get, what it costs, and when.</li>
        <li><strong>Own it.</strong> The code and the records are yours.</li>
      </ol>
      <p><a class="btn btn-primary" href={mailto}>Email me</a></p>
    </div>
  </section>
</Base>
