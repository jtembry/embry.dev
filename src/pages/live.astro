---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LiveFeed from '../components/LiveFeed.astro';
import site from '../data/site.json';
---
<Base title="Live from the printer" description="Watch the Bambu Lab P2S in Embry Development's Louisville shop print in real time.">
  <Hero variant="layers" seed={9} eyebrow={`Live · ${site.location}`} title="Watch it print.">
    <p class="lede">The camera inside the Bambu Lab P2S, streamed from the shop while a job is running. It shows the print chamber and nothing else.</p>
  </Hero>
  <section class="section">
    <div class="wrap">
      <LiveFeed />
      <p class="muted">Idle between jobs. Finished work is in the <a href="/prints">print gallery</a>; the service itself is <a href="/printing">design and 3D printing</a>.</p>
    </div>
  </section>
</Base>
