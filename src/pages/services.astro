---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="Services" description="One offer and two side doors: an AI system for your office that files what comes in and shows you what needs you, custom software for any business, and design plus 3D printing.">
  <Hero variant="graph" seed={11} tall mapLabel="Explore the system I built" eyebrow="Services" title="One system. Two side doors.">
    <p class="lede">Every job starts with a one-page scope and a fixed price, so you know the cost before the work begins.</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="card">
          <p class="index">01</p>
          <h3><a href="/knowledge-assistants">An AI system for your office</a></h3>
          <p class="problem">"Everything waits for me."</p>
          <p>A system on a computer you own that reads what comes in, files it, drafts the reply, and answers from your own files with the source. Field Agent puts it on your phone.</p>
          <p>Then <a href="/knowledge-assistants/ai-adoption">four weeks of training</a> so your team actually uses it.</p>
        </div>
        <div class="card">
          <p class="index">02</p>
          <h3><a href="/software">Custom software for any business</a></h3>
          <p class="problem">"We pay for five tools and still run the business on a spreadsheet."</p>
          <p>Software built around the way you already work, with your records kept in a place you own.</p>
        </div>
        <div class="card">
          <p class="index">03</p>
          <h3><a href="/printing">Design and 3D printing</a></h3>
          <p class="problem">"We need a part, a prototype, or a small run that no catalog sells."</p>
          <p>CAD from your sketch or measurements, working prints, and small batches. You get the part and the files.</p>
        </div>
      </div>
      <p><a class="btn btn-primary" href={mailto}>Email me</a></p>
    </div>
  </section>
</Base>
