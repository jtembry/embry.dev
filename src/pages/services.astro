---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="Services" description="You pay for an AI account that has never seen your files. I build the missing piece on a computer you own and train the staff. Software solutions and 3D printing sit beside that.">
  <Hero variant="graph" seed={11} tall mapLabel="Explore the system I built" eyebrow="Services" title="One system. Two side doors.">
    <p class="lede">Every job starts with a one-page scope and a fixed price, so you know the cost before the work begins.</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="card">
          <p class="index">01</p>
          <h3><a href="/knowledge-assistants">An AI system for your office</a></h3>
          <p class="problem">"We pay for AI that has never seen our files."</p>
          <p>I build what the office is missing, on a computer you own. It uses the Claude, ChatGPT, or Grok account you already pay for, keeps client files off a personal chat, and answers from your own documents with the page.</p>
          <p>Then <a href="/knowledge-assistants/ai-adoption">four weeks of training</a> so your staff know how to use it.</p>
        </div>
        <div class="card">
          <p class="index">02</p>
          <h3><a href="/software">Software solutions for any business</a></h3>
          <p class="problem">"We pay for five tools and still run the business on a spreadsheet."</p>
          <p>Software built around the way you already work, with your records kept in a place you own.</p>
        </div>
        <div class="card">
          <p class="index">03</p>
          <h3><a href="/printing">Design and 3D printing</a></h3>
          <p class="problem">"We need a card, a tag, a part, or a short run that no catalog sells."</p>
          <p>Dog tags, business cards, cable clips, giveaways, and the piece that has to be this shape. You get the pieces and the files.</p>
        </div>
      </div>
      <p><a class="btn btn-primary" href={mailto}>Email me</a></p>
    </div>
  </section>
</Base>
