---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="Services" description="Four things Embry Development builds: AI adoption for engineering teams, knowledge assistants for small practices, websites with automation for small businesses, and design plus 3D printing.">
  <Hero variant="graph" seed={11} eyebrow="Services" title="Four things I build.">
    <p class="lede">Every job starts with a one-page scope and a fixed price, so you know the cost before the work begins.</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="card">
          <p class="index">01</p>
          <h3><a href="/ai-adoption">AI adoption for engineering teams</a></h3>
          <p class="problem">"We bought the AI seats and nothing changed."</p>
          <p>A four-week pilot on one real repo: I audit the workflow, set up agents where they save time, and measure before and after.</p>
        </div>
        <div class="card">
          <p class="index">02</p>
          <h3><a href="/knowledge-assistants">Knowledge assistants for small practices</a></h3>
          <p class="problem">"Our knowledge is in documents nobody can search."</p>
          <p>A private assistant that searches your own files, runs on servers you control, and answers with citations.</p>
        </div>
        <div class="card">
          <p class="index">03</p>
          <h3><a href="/websites">Websites and automation for small businesses</a></h3>
          <p class="problem">"We need a site and the plumbing behind it without an agency bill."</p>
          <p>A fast site you own on your own domain, hosted for free, plus the forms, booking, and email behind it.</p>
        </div>
        <div class="card">
          <p class="index">04</p>
          <h3><a href="/printing">Design and 3D printing</a></h3>
          <p class="problem">"We need a part, a prototype, or a small run that no catalog sells."</p>
          <p>CAD from your sketch or measurements, working prints, and small batches. You get the part and the files.</p>
        </div>
      </div>
      <p><a class="btn btn-primary" href={mailto}>Email me</a></p>
    </div>
  </section>
</Base>
