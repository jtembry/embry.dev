---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="Services" description="Three things Embry Development builds: knowledge assistants for small practices (with training so your team uses them), custom SaaS for small businesses, and design plus 3D printing.">
  <Hero variant="graph" seed={11} diagram="index" eyebrow="Services" title="Three things I build.">
    <p class="lede">Every job starts with a one-page scope and a fixed price, so you know the cost before the work begins.</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        <div class="card">
          <p class="index">01</p>
          <h3><a href="/knowledge-assistants">Knowledge assistants for small practices</a></h3>
          <p class="problem">"Our knowledge is in documents nobody can search."</p>
          <p>A private assistant that searches your own files, runs on servers you control, and answers with citations.</p>
          <p>Then <a href="/knowledge-assistants/ai-adoption">four weeks of training</a> so your team actually uses it.</p>
        </div>
        <div class="card">
          <p class="index">02</p>
          <h3><a href="/software">Custom SaaS for small businesses</a></h3>
          <p class="problem">"We pay for five tools and still run the business on a spreadsheet."</p>
          <p>A web app built around the way you already work, with your data in a database you own.</p>
        </div>
        <div class="card">
          <p class="index">03</p>
          <h3><a href="/printing">Design and 3D printing</a></h3>
          <p class="problem">"We need a part, a prototype, or a small run that no catalog sells."</p>
          <p>CAD from your sketch or measurements, working prints, and small batches. You get the part and the files.</p>
        </div>
      </div>
      <p><a class="btn btn-primary" href={mailto}>Email me</a></p>
    </div>
  </section>
</Base>
