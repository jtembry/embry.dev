---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceLinks from '../components/ServiceLinks.astro';
import site from '../data/site.json';
import { graph } from '../lib/patterns.js';
const ask = `mailto:${site.email}?subject=${encodeURIComponent('Website for my business')}`;
const bodyBg = graph({ parity: 0, seed: 14, cx: 1200, cy: 450, satellites: 70 });
---
<Base title="Websites and automation for small businesses" description="A fast site you own on your own domain, hosted for free, plus the booking, forms, and email plumbing behind it. Fixed price.">
  <Hero variant="graph" seed={23} eyebrow="Service · Small businesses" title="Websites and automation for small businesses">
    <p class="lede"><em>"We need a site and the plumbing behind it without an agency bill."</em> A fast, plain site on your own domain that costs nothing a month to host and that you can update yourself. Then the plumbing: booking, contact forms that reach you, email on your domain, and the small automations that stop you re-typing things.</p>
    <p><a class="btn btn-primary" href={ask}>Ask about a site</a></p>
  </Hero>

  <section class="section band-parallax">
    <div class="band-bg" data-parallax="0.35" set:html={bodyBg} aria-hidden="true" />
    <div class="wrap">
      <h2>What you get</h2>
      <ul>
        <li>A static site you own, in your own GitHub account, deployed automatically when you change it.</li>
        <li>Copy worked out with you, not lorem ipsum with your logo on it.</li>
        <li>Booking, forms, and domain email wired up and tested.</li>
        <li>A written guide so you, or the next person, can run it without me.</li>
      </ul>
      <h2>Most recent</h2>
      <p><a href="https://flourishfinancialgroup.org">Flourish Financial Group</a>, a financial counselor's site: live a month after the first conversation, $0 a month to host, and run by its owner.</p>
      <p><span class="tag">Fixed price</span> <span class="tag">$0/month hosting</span> <span class="tag">You own it</span></p>
      <p><a class="btn btn-primary" href={ask}>Ask about a site</a></p>
    </div>
  </section>

  <ServiceLinks current="/websites" />
</Base>
