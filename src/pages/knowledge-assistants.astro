---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceLinks from '../components/ServiceLinks.astro';
import site from '../data/site.json';
import { dots } from '../lib/patterns.js';
const ask = `mailto:${site.email}?subject=${encodeURIComponent('Knowledge assistant for our practice')}`;
const bodyBg = dots();
---
<Base title="Knowledge assistants for small practices" description="A private assistant that searches your own documents, runs on servers you control, and answers with citations. For law offices, clinics, and small firms.">
  <Hero variant="graph" seed={5} diagram="secondBrain" mapLabel="See the knowledge system I run on" eyebrow="Knowledge assistants · Small practices" title="The last assistant you will ever need to train.">
    <p class="lede"><em>"Our knowledge is in documents nobody can search."</em> Law offices, clinics, and small firms hold years of filings, notes, and precedent, and the people who know where things are retire. I build a private assistant that searches your own documents and answers with a citation to the source.</p>
    <a slot="actions" class="btn btn-secondary btn-lg" href={ask}>Ask about an assistant</a>
  </Hero>

  <section class="section band-parallax">
    <div class="band-bg" set:html={bodyBg} aria-hidden="true" />
    <div class="wrap">
      <h2>What you get</h2>
      <ul>
        <li>Your documents indexed in place, with access rules that match your practice.</li>
        <li>An assistant that takes plain-English questions from your staff and shows its sources every time.</li>
        <li>Servers you control. Your data stays on your systems unless you choose a hosted model.</li>
        <li>A fixed-scope build, then optional monthly care for updates and new document sets.</li>
      </ul>
      <h2>Then: teach your team to use it</h2>
      <p>An assistant nobody uses is a cost, not a tool. Four weeks of training, beside your staff on real work, teaches them how to ask, how to check the sources, and where the assistant fits in the day. I measure the change in your own records. <a href="/knowledge-assistants/ai-adoption">How the training works</a></p>
      <h2>Where it comes from</h2>
      <p>I run one of these for myself: a personal knowledge system where agents file email, texts, scans, and notes into a searchable vault every day. It is the working prototype for this offer.</p>
      <p><span class="tag">Fixed scope</span> <span class="tag">Optional monthly care</span> <span class="tag">Quote on scope</span></p>
      <p><a class="btn btn-primary" href={ask}>Ask about an assistant</a></p>
    </div>
  </section>

  <ServiceLinks current="/knowledge-assistants" />
</Base>
