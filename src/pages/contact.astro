---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { graph } from '../lib/patterns.js';
const bodyBg = graph({ parity: 0, seed: 42, cx: 1250, cy: 350, satellites: 60 });
import site from '../data/site.json';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="Contact" description="Email JT Embry at Embry Development, LLC in Louisville to start a software, AI, website, or 3D printing project.">
  <Hero variant="graph" seed={41} eyebrow="Contact" title="One email starts it.">
    <p class="lede">Tell me the problem in a few sentences. I read everything and reply within two business days, usually sooner.</p>
    <p><a class="btn btn-primary" href={mailto}>Email {site.email}</a></p>
  </Hero>

  <section class="section band-parallax">
    <div class="band-bg" data-parallax="0.55" set:html={bodyBg} aria-hidden="true" />
    <div class="wrap">
      <h2>Useful to include</h2>
      <ul>
        <li><strong>Software or AI:</strong> what your team or practice is trying to do, what's in the way, and any deadline attached to it.</li>
        <li><strong>A website:</strong> what you do, who it's for, any site you have now, and whether you own a domain.</li>
        <li><strong>3D printing:</strong> a photo with something for scale, rough dimensions, how many, and where the part will live. Or just the STL.</li>
      </ul>
      <h2>Elsewhere</h2>
      <p><a href={site.linkedin} rel="me">LinkedIn</a> · <a href={site.github} rel="me">GitHub</a><br />{site.legalName} · {site.location}</p>
    </div>
  </section>
</Base>
