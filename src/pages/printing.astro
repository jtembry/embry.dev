---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { dots } from '../lib/patterns.js';
const howBg = dots();
import site from '../data/site.json';
import ServiceLinks from '../components/ServiceLinks.astro';
import LiveFeed from '../components/LiveFeed.astro';
import PrintGallery from '../components/PrintGallery.astro';
const quote = `mailto:${site.email}?subject=${encodeURIComponent('3D printing quote')}&body=${encodeURIComponent('What I need:\n\nDimensions or a photo/sketch:\n\nHow many:\n\nWhere it will be used (indoors, outdoors, heat, load):\n')}`;
---
<Base title="Design and 3D printing" description="CAD design and 3D printing in Louisville: replacement parts, brackets, jigs, enclosures, prototypes, and small runs.">
  <Hero variant="layers" diagram="printingView" mapLabel="See my print pipeline" eyebrow={`Service · Design and 3D printing · ${site.location}`} title="The part no catalog sells.">
    <p class="lede">The broken clip on a thing you like, the bracket that must be exactly this shape, the prototype before you pay for tooling, twenty of something for a booth: send me a photo, a sketch, or a file, and I'll quote it.</p>
    <a slot="actions" class="btn btn-secondary btn-lg" href={quote}>Request a quote</a>
  </Hero>

  <section class="section" id="shop">
    <div class="wrap">
      <h2 id="live">Watch it print</h2>
      <p class="muted">The camera inside the P2S, streamed while a job is running. It shows the print chamber and nothing else.</p>
      <LiveFeed />
      <h2 id="prints">Off the bed</h2>
      <p class="muted">Every print that has come off the P2S, newest first.</p>
      <PrintGallery />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What I print</h2>
      <div class="grid">
        <div class="card"><h3>Replacement parts</h3><p>Knobs, clips, hinges, feet, and the plastic piece nobody sells on its own. I measure from the original or its mate.</p></div>
        <div class="card"><h3>Brackets, jigs, and fixtures</h3><p>Mounts, holders, guides, and shop fixtures made to your dimensions instead of the nearest stock size.</p></div>
        <div class="card"><h3>Enclosures</h3><p>Cases for boards, sensors, and small electronics, with the cutouts where your connectors are.</p></div>
        <div class="card"><h3>Prototypes and small runs</h3><p>I print one to check the fit, then a few dozen, in one color or several.</p></div>
      </div>
    </div>
  </section>

  <section class="section band band-parallax">
    <div class="band-bg" set:html={howBg} aria-hidden="true" />
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Send what you have.</strong> A photo with a ruler in it, a sketch with dimensions, or an STL or STEP file. Say how many you need and where the part will be used.</li>
        <li><strong>Get a quote.</strong> I quote design time, if any, and a per-part price, usually within a day.</li>
        <li><strong>Check the fit.</strong> If the part must mate with something, you get one to test before the run.</li>
        <li><strong>Pick up or ship.</strong> Pick up in Louisville or have it shipped. You get the files too, so you can reprint anywhere.</li>
      </ol>
      <h3>Materials and equipment</h3>
      <dl class="spec">
        <dt>Printer</dt><dd>Bambu Lab P2S, enclosed, prints in several colors</dd>
        <dt>Everyday</dt><dd>PLA for indoor parts and prototypes</dd>
        <dt>Tough</dt><dd>PETG for outdoor use, moisture, and moderate heat</dd>
        <dt>Flexible</dt><dd>TPU for gaskets, feet, bumpers, and grips</dd>
        <dt>Heat and impact</dt><dd>ABS and ASA for parts near engines, sun, and rough handling</dd>
        <dt>Design</dt><dd>CAD from your sketch or measurements, billed hourly; you keep the files</dd>
      </dl>
      <p><span class="tag">Quote per job</span> <span class="tag">Local pickup</span> <span class="tag">You keep the files</span></p>
      <p><a class="btn btn-primary" href={quote}>Request a quote</a></p>
    </div>
  </section>
  <ServiceLinks current="/printing" />
</Base>
