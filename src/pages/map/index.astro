---
// The system map as one story, top to bottom: things come in, each arrives with a plan, one swipe
// decides, it lands where it can be found. A spine down the middle fills as you scroll and a dot
// rides it. Written by hand to match the flow JT actually uses; the LikeC4 charts stay private
// (vault System/System Map.md, ~/Projects/system-map).
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const doors = [
  { title: 'Email & texts', how: 'Show up on the phone the moment they arrive.' },
  { title: 'Paper', how: 'Press Scan. The page is read and given a name.' },
  { title: 'Anything else', how: 'Share it from any app on the phone: a photo, a link, a file.' },
];
const swipes = [
  { k: 'Triage', t: 'file it as planned' },
  { k: 'Archive', t: 'done, out of the list' },
  { k: 'Delete', t: 'gone' },
  { k: 'Respond', t: 'a drafted reply; I send it' },
];
const shelves = [
  { title: 'Projects', note: 'things with a finish line' },
  { title: 'Areas', note: 'ongoing duties' },
  { title: 'Documents', note: 'every PDF, searchable' },
  { title: 'Reminders', note: 'to-dos with a date' },
];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="How my own system works" description="Things come in, each one arrives with a plan, one swipe on the phone decides, and it lands where I will find it.">
  <section class="band-dark flow-hero">
    <div class="wrap">
      <p class="eyebrow">System map</p>
      <h1>How my own system works</h1>
      <p class="lede">My own setup, in four steps. Client systems start from the same four.</p>
    </div>
  </section>

  <div class="flow" id="flow">
    <div class="flow-bg" data-depth="0.5" aria-hidden="true"></div>
    <div class="flow-spine" aria-hidden="true"><span class="flow-dot"></span></div>

    <section class="flow-stage" id="in">
      <div class="wrap flow-head">
        <p class="flow-num">1</p>
        <h2>Things come in</h2>
        <p>Three doors, one list on the phone. Nothing gets retyped.</p>
      </div>
      <div class="wrap flow-fig" data-depth="-0.3">
        <ul class="doors">
          {doors.map((d) => (
            <li class="door">
              <h3>{d.title}</h3>
              <p>{d.how}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="flow-stage" id="plan">
      <div class="wrap flow-head">
        <p class="flow-num">2</p>
        <h2>Each one comes with a plan</h2>
        <p>Before I look, an AI model reads the item and writes one line: where it goes and what to do. A scan with a Social Security or card number skips this and goes straight to a locked folder.</p>
      </div>
      <div class="wrap flow-fig" data-depth="-0.3">
        <div class="box">
          <strong>Email: “Can you quote a bracket?”</strong>
          <span>Plan: to-do in Quote: custom bracket, due Friday</span>
        </div>
      </div>
    </section>

    <section class="flow-stage" id="decide">
      <div class="wrap flow-head">
        <p class="flow-num">3</p>
        <h2>I decide with one swipe</h2>
        <p>On <a href="/products">FieldADE</a>, every row has the same four moves. Triage shows me the plan first; I confirm it, or add a sentence of context and it plans again. Nothing is filed or sent without my tap.</p>
      </div>
      <div class="wrap flow-fig" data-depth="-0.3">
        <div class="phone-frame">
          <p class="phone-title">Today</p>
          <ul class="phone-rows">
            {swipes.map((s) => <li><span class="row-k">{s.k}</span> {s.t}</li>)}
          </ul>
          <p class="phone-ask"><span>To-do in Quote: custom bracket, due Friday?</span><b>Triage</b><b>Cancel</b></p>
        </div>
      </div>
    </section>

    <section class="flow-stage flow-stage-end" id="find">
      <div class="wrap flow-head">
        <p class="flow-num">4</p>
        <h2>It lands where I will find it</h2>
        <p>Filed into plain notes on my Mac, not a vendor’s cloud. Search on the phone finds it by meaning, not just by name.</p>
      </div>
      <div class="wrap flow-fig" data-depth="-0.3">
        <ul class="shelves">
          {shelves.map((s) => (
            <li class="shelf"><strong>{s.title}</strong><span>{s.note}</span></li>
          ))}
        </ul>
        <p class="flow-foot">Backed up to two disks at home, taking turns, and the notes also sync to iCloud.</p>
      </div>
    </section>
  </div>

  <section class="section band flow-after">
    <div class="wrap">
      <h2>The same four steps, for your business</h2>
      <p>Swap my doors for yours: customer email, quotes, invoices, job photos, the paperwork on the truck seat. The plan, the swipe, and the shelves stay the same. <a href="/knowledge-assistants">What you get</a>.</p>
      <p class="hero-actions"><a class="btn btn-primary" href={mailto}>Email me</a> {site.calUrl ? <a class="btn btn-secondary" href={site.calUrl} target="_blank" rel="noopener">See it running</a> : site.booking ? <button type="button" class="btn btn-secondary" data-book>See it running</button> : <a class="btn btn-secondary" href="/products">See it running</a>}</p>
    </div>
  </section>
</Base>

<script>
  // Spine fill, the riding dot, and a little depth. Only when the visitor allows motion.
  const html = document.documentElement;
  const stages = Array.from(document.querySelectorAll('.flow-stage'));
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) e.target.classList.add('in');
  }, { rootMargin: '0px 0px -15% 0px' });
  stages.forEach((s) => seen.observe(s));

  if (html.classList.contains('motion')) {
    const flow = document.getElementById('flow');
    const spine = flow.querySelector('.flow-spine');
    const layers = Array.from(flow.querySelectorAll('[data-depth]'));
    let queued = false;
    const frame = () => {
      queued = false;
      const vh = window.innerHeight;
      const r = spine.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (vh * 0.55 - r.top) / r.height));
      spine.style.setProperty('--p', p.toFixed(4));
      for (const el of layers) {
        const d = Number(el.dataset.depth);
        const b = el.getBoundingClientRect();
        const c = (b.top + b.height / 2 - vh / 2) / vh;
        el.style.transform = `translate3d(0, ${(c * d * 90).toFixed(1)}px, 0)`;
      }
    };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
    window.addEventListener('scroll', ask, { passive: true });
    window.addEventListener('resize', ask);
    frame();
  }
</script>

<style>
  .flow-hero { padding: calc(var(--header-h) + 2.5rem) 0 3rem; }
  .flow-hero h1 { margin-bottom: .6rem; }
  .flow { position: relative; overflow: hidden; --spine-x: 50%; }
  .flow-bg { position: absolute; inset: -20% 0; background-image: radial-gradient(rgba(176, 74, 16, .18) 1px, transparent 1.5px); background-size: 28px 28px; pointer-events: none; will-change: transform; }
  .flow-spine { position: absolute; top: 0; bottom: 0; left: var(--spine-x); width: 3px; margin-left: -1.5px; --p: 0;
    background: linear-gradient(to bottom, var(--accent-bright) calc(var(--p) * 100%), var(--line) calc(var(--p) * 100%)); }
  .flow-dot { position: absolute; left: 50%; top: calc(var(--p) * 100%); width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: var(--accent-bright); box-shadow: 0 0 0 5px rgba(52, 199, 89, .25), 0 0 18px rgba(52, 199, 89, .6); }
  .flow-stage { position: relative; padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2rem, 5vw, 3.5rem); }
  .flow-head { position: relative; text-align: center; }
  .flow-head h2 { margin-top: .4rem; }
  .flow-head p { margin-inline: auto; }
  /* Text sits on a patch of page colour so the spine runs behind it, not through it. */
  .flow-head h2, .flow-head p:not(.flow-num), .flow-foot { position: relative; width: fit-content; margin-inline: auto; background: var(--bg); box-shadow: 0 0 0 .6rem var(--bg); border-radius: 4px; }
  .flow-num { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; margin: 0; border-radius: 50%; background: var(--accent-bright); color: var(--ink); font-family: var(--mono); font-weight: 600; font-size: 1.1rem; box-shadow: 0 0 0 6px var(--bg); }
  .flow-fig { position: relative; margin-top: 1.75rem; will-change: transform; }
  .flow-foot { margin-top: 1.75rem; text-align: center; font-size: .95rem; color: var(--muted); }

  .doors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .door { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .door h3 { margin: 0 0 .35rem; font-size: 1.05rem; }
  .door p { margin: 0; font-size: .95rem; color: var(--ink-2); }

  .box { display: flex; flex-direction: column; gap: .35rem; width: min(100%, 26rem); margin-inline: auto; padding: 1.1rem 1.3rem; border-radius: var(--radius); background: var(--band); color: var(--white); text-align: center; border: 2px solid var(--accent-bright); box-shadow: 0 12px 36px rgba(20, 22, 28, .18); }
  .box strong { font-size: 1.05rem; }
  .box span { font-family: var(--mono); font-size: .8rem; color: #9be5ad; }
  .shelves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .shelf { display: flex; flex-direction: column; gap: .15rem; padding: .8rem .9rem; background: var(--white); border: 1px dashed var(--muted); border-radius: var(--radius); text-align: center; }
  .shelf strong { font-size: .98rem; }
  .shelf span { font-size: .85rem; color: var(--muted); }

  .phone-frame { width: min(100%, 20rem); margin-inline: auto; padding: 1.1rem 1rem 1rem; border-radius: 26px; background: var(--band); color: var(--bg); border: 6px solid #0d0f13; box-shadow: 0 18px 50px rgba(20, 22, 28, .3); }
  .phone-title { margin: 0 0 .7rem; font-family: var(--mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-bright); }
  .phone-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; font-size: .9rem; }
  .phone-rows li { padding: .55rem .7rem; border-radius: 8px; background: var(--band-2); }
  .row-k { display: inline-block; min-width: 4.4rem; margin-right: .3rem; font-family: var(--mono); font-size: .72rem; text-transform: uppercase; color: #9be5ad; }
  .phone-ask { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: .8rem 0 0; padding: .6rem .7rem; border-radius: 8px; background: var(--accent-tint); color: var(--ink); font-size: .85rem; }
  .phone-ask span { flex: 1 1 100%; }
  .phone-ask b { padding: .25rem .7rem; border-radius: 6px; background: var(--accent-bright); font-weight: 600; }
  .phone-ask b + b { background: transparent; border: 1.5px solid var(--ink-2); }
  :global(html[data-look="dos"]) .box { color: var(--ink); border: 2px solid var(--accent-bright); box-shadow: none; }
  :global(html[data-look="dos"]) .box span, :global(html[data-look="dos"]) .row-k { color: var(--muted); }
  :global(html[data-look="dos"]) .phone-frame { color: var(--ink); border-color: var(--line); box-shadow: none; }
  :global(html[data-look="dos"]) .flow-num, :global(html[data-look="dos"]) .phone-ask b { color: #000; text-shadow: none; }
  :global(html[data-look="dos"]) .flow-bg { background-image: radial-gradient(rgba(0, 255, 77, .14) 1px, transparent 1.5px); }
  :global(html[data-look="dos"]) .flow-dot { box-shadow: 0 0 0 5px rgba(0, 255, 77, .25), 0 0 18px rgba(0, 255, 77, .55); }

  .flow-stage-end { padding-bottom: clamp(3rem, 8vw, 5rem); }
  .flow-after h2 { margin-top: 0; }

  /* Reveal as each step scrolls in. */
  :global(html.motion) .flow-stage .flow-head, :global(html.motion) .flow-stage .flow-fig { opacity: 0; translate: 0 24px; transition: opacity .6s ease, translate .7s cubic-bezier(.2, .7, .2, 1); }
  :global(html.motion) .flow-stage .flow-fig { transition-delay: .12s; }
  :global(html.motion) .flow-stage.in .flow-head, :global(html.motion) .flow-stage.in .flow-fig { opacity: 1; translate: 0 0; }

  @media (max-width: 48rem) {
    .doors { grid-template-columns: 1fr; }
    .shelves { grid-template-columns: 1fr 1fr; }
    .flow-fig { margin-top: 1.25rem; }
    .flow-head p { font-size: 1rem; }
  }
</style>
