---
// The system map as one story, top to bottom: things come in, one swipe shows the plan, it shows up
// where it is needed. Each step is a real FieldADE screen on sample data (scripts/fieldade-shots),
// in both looks. A spine down the middle fills as you scroll and a dot rides it. The LikeC4 charts
// stay private (vault System/System Map.md, ~/Projects/system-map).
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const steps = [
  { id: 'in', title: 'Things come in',
    body: 'Email and texts show up the moment they arrive. A scanned page, or anything shared from another app, lands in the same app beside them. No one retypes anything.',
    shot: 'email', alt: 'FieldADE’s Email screen: five unread messages' },
  { id: 'plan', title: 'One swipe shows the plan',
    body: 'An AI model has already read each item and written where it goes. I swipe Triage and see that plan before anything happens: confirm it, add a sentence of context, or cancel. The other swipes are Archive, Delete, and Respond, which drafts a reply for me to send.',
    shot: 'triage', alt: 'The triage confirm: “To-do in Henderson Kitchen?”, with the to-do and its due date, and Triage, Add context, Cancel' },
  { id: 'find', title: 'It shows up where I need it',
    body: 'Each item goes into plain notes on my Mac, under the right project. A dated to-do lands on the Today screen and in Reminders. Search on the phone finds the rest by meaning.',
    shot: 'today', alt: 'FieldADE’s Today screen: the new to-do, “Send Dana a start date”, at the top of Due' },
];
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`;
---
<Base title="How my own system works" description="Things come in, one swipe shows the plan, and it shows up where I need it. Real FieldADE screens with sample data.">
  <section class="band-dark flow-hero">
    <div class="wrap">
      <p class="eyebrow">System map</p>
      <h1>How my own system works</h1>
      <p class="lede">My own setup, in three steps. These are real screens from the app, filled with sample data.</p>
    </div>
  </section>

  <div class="flow" id="flow">
    <div class="flow-bg" data-depth="0.5" aria-hidden="true"></div>
    <div class="flow-spine" aria-hidden="true"><span class="flow-dot"></span></div>

    {steps.map((st, i) => (
      <section class={`flow-stage${i === steps.length - 1 ? ' flow-stage-end' : ''}`} id={st.id}>
        <div class="wrap flow-head">
          <p class="flow-num">{i + 1}</p>
          <h2>{st.title}</h2>
          <p>{st.body}</p>
        </div>
        <div class="wrap flow-fig" data-depth="-0.3">
          <img class="shot look-pro-only" src={`/map/${st.shot}.png?v=20261120`} alt={st.alt} width="460" height="1000" loading="lazy" />
          <img class="shot look-dos-only" src={`/map/${st.shot}-dos.png?v=20261120`} alt={`${st.alt}, in the DOS look`} width="460" height="1000" loading="lazy" />
          {i === steps.length - 1 && <p class="flow-foot">Two disks at home take turns backing it all up, and the notes also sync to iCloud.</p>}
        </div>
      </section>
    ))}
  </div>

  <section class="section band flow-after">
    <div class="wrap">
      <h2>The same three steps, for your business</h2>
      <p>Swap my inbox for yours: customer email, quotes, invoices, job photos, the paperwork on the truck seat. The plan, the swipe, and the filing stay the same. <a href="/knowledge-assistants">What you get</a>.</p>
      <p class="hero-actions"><a class="btn btn-primary" href={mailto}>Email me</a> {site.calUrl ? <a class="btn btn-secondary" href={site.calUrl} target="_blank" rel="noopener">See it running</a> : site.booking ? <button type="button" class="btn btn-secondary" data-book>See it running</button> : <a class="btn btn-secondary" href="/products">See it running</a>}</p>
    </div>
  </section>
</Base>

<script>
  // Spine fill, the riding dot, and a little depth. Only when the visitor allows motion.
  const html = document.documentElement;
  const stages = Array.from(document.querySelectorAll('.flow-stage'));
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) e.target.classList.add('in');
  }, { rootMargin: '0px 0px -15% 0px' });
  stages.forEach((s) => seen.observe(s));

  if (html.classList.contains('motion')) {
    const flow = document.getElementById('flow');
    const spine = flow.querySelector('.flow-spine');
    const layers = Array.from(flow.querySelectorAll('[data-depth]'));
    let queued = false;
    const frame = () => {
      queued = false;
      const vh = window.innerHeight;
      const r = spine.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (vh * 0.55 - r.top) / r.height));
      spine.style.setProperty('--p', p.toFixed(4));
      for (const el of layers) {
        const d = Number(el.dataset.depth);
        const b = el.getBoundingClientRect();
        const c = (b.top + b.height / 2 - vh / 2) / vh;
        el.style.transform = `translate3d(0, ${(c * d * 90).toFixed(1)}px, 0)`;
      }
    };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
    window.addEventListener('scroll', ask, { passive: true });
    window.addEventListener('resize', ask);
    frame();
  }
</script>

<style>
  .flow-hero { padding: calc(var(--header-h) + 2.5rem) 0 3rem; }
  .flow-hero h1 { margin-bottom: .6rem; }
  .flow { position: relative; overflow: hidden; --spine-x: 50%; }
  .flow-bg { position: absolute; inset: -20% 0; background-image: radial-gradient(rgba(176, 74, 16, .18) 1px, transparent 1.5px); background-size: 28px 28px; pointer-events: none; will-change: transform; }
  .flow-spine { position: absolute; top: 0; bottom: 0; left: var(--spine-x); width: 3px; margin-left: -1.5px; --p: 0;
    background: linear-gradient(to bottom, var(--accent-bright) calc(var(--p) * 100%), var(--line) calc(var(--p) * 100%)); }
  .flow-dot { position: absolute; left: 50%; top: calc(var(--p) * 100%); width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; background: var(--accent-bright); box-shadow: 0 0 0 5px rgba(52, 199, 89, .25), 0 0 18px rgba(52, 199, 89, .6); }
  .flow-stage { position: relative; padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2rem, 5vw, 3.5rem); }
  .flow-head { position: relative; text-align: center; }
  .flow-head h2 { margin-top: .4rem; }
  .flow-head p { margin-inline: auto; }
  /* Text sits on a patch of page colour so the spine runs behind it, not through it. */
  .flow-head h2, .flow-head p:not(.flow-num), .flow-foot { position: relative; width: fit-content; margin-inline: auto; background: var(--bg); box-shadow: 0 0 0 .6rem var(--bg); border-radius: 4px; }
  .flow-num { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; margin: 0; border-radius: 50%; background: var(--accent-bright); color: var(--ink); font-family: var(--mono); font-weight: 600; font-size: 1.1rem; box-shadow: 0 0 0 6px var(--bg); }
  .flow-fig { position: relative; margin-top: 1.75rem; will-change: transform; }
  .flow-foot { margin-top: 1.75rem; text-align: center; font-size: .95rem; color: var(--muted); }

  .shot { display: block; width: min(100%, 17rem); height: auto; margin-inline: auto; border-radius: 34px; border: 6px solid #0d0f13; box-shadow: 0 18px 50px rgba(20, 22, 28, .3); background: #0d0f13; }
  :global(html[data-look="dos"]) .shot { border-color: var(--line); box-shadow: none; }
  :global(html[data-look="dos"]) .flow-num { color: #000; text-shadow: none; }
  :global(html[data-look="dos"]) .flow-bg { background-image: radial-gradient(rgba(0, 255, 77, .14) 1px, transparent 1.5px); }
  :global(html[data-look="dos"]) .flow-dot { box-shadow: 0 0 0 5px rgba(0, 255, 77, .25), 0 0 18px rgba(0, 255, 77, .55); }

  .flow-stage-end { padding-bottom: clamp(3rem, 8vw, 5rem); }
  .flow-after h2 { margin-top: 0; }

  /* Reveal as each step scrolls in. */
  :global(html.motion) .flow-stage .flow-head, :global(html.motion) .flow-stage .flow-fig { opacity: 0; translate: 0 24px; transition: opacity .6s ease, translate .7s cubic-bezier(.2, .7, .2, 1); }
  :global(html.motion) .flow-stage .flow-fig { transition-delay: .12s; }
  :global(html.motion) .flow-stage.in .flow-head, :global(html.motion) .flow-stage.in .flow-fig { opacity: 1; translate: 0 0; }

  @media (max-width: 48rem) {
    .flow-fig { margin-top: 1.25rem; }
    .flow-head p { font-size: 1rem; }
  }
</style>
