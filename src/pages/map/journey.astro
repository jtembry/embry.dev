---
// Follow one item through the system. Pick an item; a card rides a track through five stations
// (door, in-tray, sorting, shelf, phone) while a caption says what happens at each. The sorting
// station is drawn as a fork: the branch the item takes lights up. Plain HTML, a little JS to move
// the card; with reduced motion the card jumps instead of sliding.
import Base from '../../layouts/Base.astro';

const branches = [
  { id: 'project', q: 'Has a finish line?', to: 'Project' },
  { id: 'area', q: 'An ongoing duty?', to: 'Area' },
  { id: 'idea', q: 'Worth keeping on its own?', to: 'Idea' },
  { id: 'noise', q: 'None of those?', to: 'Archive' },
];
const shelves = [
  { id: 'project', name: 'Projects', note: 'things with a finish line' },
  { id: 'area', name: 'Areas', note: 'ongoing duties' },
  { id: 'idea', name: 'Ideas', note: 'one per note, linked' },
];
// One scenario per door. Each step: what the caption says, plus which branch and shelf light up.
const scenarios = [
  {
    id: 'scan', label: 'A scanned letter', card: 'Letter from the insurer', door: 'Paper',
    branch: 'area', shelf: 'area', dest: 'Area · House',
    steps: [
      'I press Scan. The pages go straight to the Mac, the text is read, and a name is proposed: “Home insurance renewal 2027”.',
      'The PDF and a note with its full text land in the in-tray. The phone shows one alert: approve the name and folder, or change it.',
      'The assistant reads the note. No deadline, but it is about the house, a duty that never ends. Rule: an ongoing duty goes to an Area.',
      'The note is filed under the House area and linked to the PDF, so one search for “insurance” finds it next year.',
      'Mission Control lists it once under Filed. If the letter had a date, it would also sit under Due.',
    ],
  },
  {
    id: 'email', label: 'A customer email', card: 'Email: “Can you quote a bracket?”', door: 'Email & texts',
    branch: 'project', shelf: 'project', dest: 'Project · Quote: custom bracket',
    steps: [
      'New mail is pulled the moment it arrives. The assistant’s mail pass skips the noise and lists this one under Needs action.',
      'I tap Triage on the phone. The thread is saved as a plain file and a note with the whole conversation lands in the in-tray.',
      'The assistant reads the note. A customer wants a price by Friday. Rule: a thing with a finish line is a Project.',
      'A project folder is made, “Quote: custom bracket”, with the email as its first note and a to-do: send the quote by Friday.',
      'Mission Control shows the project’s next step, and the to-do appears in the phone’s reminders. A reply is drafted, ready to send or edit.',
    ],
  },
  {
    id: 'note', label: 'A quick note', card: 'Note: “Print cards with a QR to /about”', door: 'Notes & to-dos',
    branch: 'idea', shelf: 'idea', dest: 'Idea · Business card with a QR code',
    steps: [
      'A thought, typed into the quick-capture box on the Mac or the phone. One button, no title, no folder.',
      'It lands in the in-tray as a one-line note.',
      'The assistant reads it. Not a task, not a duty, but an idea worth keeping. Rule: one idea per note, linked to its neighbours.',
      'It becomes an Idea note, linked to the business-card project and the printing page, with two related notes suggested.',
      'Nothing to do today, so Mission Control stays quiet. The next time I search “business card”, the idea is there.',
    ],
  },
];
---
<Base title="Follow one item through" description="Pick a scanned letter, a customer email, or a quick note, and watch it travel from the door to the in-tray, through the sorting, onto its shelf, and to the phone.">
  <section class="band-dark journey-hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/map">System map</a> · Journey</p>
      <h1>Follow one item through</h1>
      <p class="lede">Pick something that came in today. Watch where it goes and why.</p>
      <p class="picker" role="tablist" aria-label="Item to follow">
        {scenarios.map((s, i) => <button type="button" role="tab" class="pick" aria-selected={i === 0 ? 'true' : 'false'} data-pick={s.id}>{s.label}</button>)}
      </p>
    </div>
  </section>

  <section class="section journey-stage">
    <div class="wrap">
      <div class="journey" id="journey">
        <ol class="stations">
          <li class="station" data-station="0">
            <p class="st-num">1</p>
            <h3>Door</h3>
            <p class="st-sub" id="door-name">Paper</p>
          </li>
          <li class="station" data-station="1">
            <p class="st-num">2</p>
            <h3>In-tray</h3>
            <p class="st-sub">one folder in the vault</p>
          </li>
          <li class="station station-sort" data-station="2">
            <p class="st-num">3</p>
            <h3>Sorting</h3>
            <ul class="branches">
              {branches.map((b) => <li class="branch" data-branch={b.id}><span class="q">{b.q}</span><span class="to">→ {b.to}</span></li>)}
            </ul>
          </li>
          <li class="station station-shelf" data-station="3">
            <p class="st-num">4</p>
            <h3>Shelf</h3>
            <ul class="shelves">
              {shelves.map((s) => <li class="shelf" data-shelf={s.id}><b>{s.name}</b><span>{s.note}</span></li>)}
            </ul>
          </li>
          <li class="station" data-station="4">
            <p class="st-num">5</p>
            <h3>Phone</h3>
            <p class="st-sub">Mission Control</p>
          </li>
        </ol>
        <div class="token" id="token" aria-hidden="true"><span id="token-text">Letter from the insurer</span></div>
      </div>

      <div class="caption" aria-live="polite">
        <p class="cap-step"><span id="cap-where">Door</span> <span class="cap-dest" id="cap-dest"></span></p>
        <p class="cap-text" id="cap-text"></p>
        <p class="controls">
          <button type="button" class="btn btn-secondary" id="prev" aria-label="Previous step">←</button>
          <button type="button" class="btn btn-primary" id="play">Pause</button>
          <button type="button" class="btn btn-secondary" id="next" aria-label="Next step">→</button>
          <span class="dots" id="dots">{[0, 1, 2, 3, 4].map(() => <i></i>)}</span>
        </p>
      </div>

      <noscript><p class="muted">The moving card needs JavaScript. The same path, in words: door → in-tray → the assistant sorts it → its shelf → the phone. <a href="/map">See the four steps</a>.</p></noscript>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2>The rule the sorting follows</h2>
      <p>The assistant asks the same four questions of every item, in order. Something with a finish line is a project. A duty that never ends is an area. A thought worth keeping on its own is an idea. Anything else is archived, and nothing with real content is archived unseen. The questions are written down, so the answer is the same on a Tuesday as on a Sunday.</p>
      <p class="hero-actions"><a class="btn btn-secondary" href="/map">Back to the four steps</a></p>
    </div>
  </section>
</Base>

<script define:vars={{ scenarios }}>
  const html = document.documentElement;
  const motion = html.classList.contains('motion');
  const journey = document.getElementById('journey');
  const token = document.getElementById('token');
  const tokenText = document.getElementById('token-text');
  const stations = Array.from(journey.querySelectorAll('.station'));
  const branches = Array.from(journey.querySelectorAll('.branch'));
  const shelves = Array.from(journey.querySelectorAll('.shelf'));
  const capWhere = document.getElementById('cap-where');
  const capDest = document.getElementById('cap-dest');
  const capText = document.getElementById('cap-text');
  const doorName = document.getElementById('door-name');
  const dots = Array.from(document.querySelectorAll('#dots i'));
  const playBtn = document.getElementById('play');
  const where = ['Door', 'In-tray', 'Sorting', 'Shelf', 'Phone'];
  const HOLD = 3400;

  let scenario = scenarios[0];
  let step = 0;
  let timer = 0;
  let playing = true;

  // The card sits on the active station; at the fork it sits on the branch it takes,
  // and on the shelf station on the shelf it lands on.
  function target() {
    if (step === 2) return branches.find((b) => b.dataset.branch === scenario.branch);
    if (step === 3) return shelves.find((s) => s.dataset.shelf === scenario.shelf);
    return stations[step];
  }
  function place() {
    const el = target();
    const r = el.getBoundingClientRect();
    const j = journey.getBoundingClientRect();
    const x = r.left - j.left + r.width / 2 - token.offsetWidth / 2;
    // On the fork and the shelf the card hovers just above the lit row, so the row stays readable.
    const y = r.top - j.top + (step === 2 || step === 3 ? -token.offsetHeight - 6 : r.height - token.offsetHeight / 2 - 8);
    token.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
  }
  function render() {
    stations.forEach((s, i) => { s.classList.toggle('on', i === step); s.classList.toggle('done', i < step); });
    branches.forEach((b) => b.classList.toggle('lit', step >= 2 && b.dataset.branch === scenario.branch));
    shelves.forEach((s) => s.classList.toggle('lit', step >= 3 && s.dataset.shelf === scenario.shelf));
    capWhere.textContent = where[step];
    capDest.textContent = step >= 3 ? scenario.dest : '';
    capText.textContent = scenario.steps[step];
    dots.forEach((d, i) => d.classList.toggle('on', i <= step));
    place();
  }
  function go(n) {
    step = (n + 5) % 5;
    render();
  }
  function schedule() {
    clearTimeout(timer);
    if (playing) timer = setTimeout(() => { go(step + 1); schedule(); }, HOLD);
  }
  function pick(id) {
    scenario = scenarios.find((s) => s.id === id) ?? scenarios[0];
    document.querySelectorAll('.pick').forEach((b) => b.setAttribute('aria-selected', b.dataset.pick === scenario.id ? 'true' : 'false'));
    tokenText.textContent = scenario.card;
    doorName.textContent = scenario.door;
    token.classList.add('jump');
    go(0);
    requestAnimationFrame(() => token.classList.remove('jump'));
    schedule();
  }

  document.querySelectorAll('.pick').forEach((b) => b.addEventListener('click', () => pick(b.dataset.pick)));
  document.getElementById('prev').addEventListener('click', () => { go(step - 1); schedule(); });
  document.getElementById('next').addEventListener('click', () => { go(step + 1); schedule(); });
  playBtn.addEventListener('click', () => {
    playing = !playing;
    playBtn.textContent = playing ? 'Pause' : 'Play';
    schedule();
  });
  window.addEventListener('resize', place);
  if (!motion) token.classList.add('jump');
  pick(scenarios[0].id);
  // Pause while the track is off screen, so the loop is not running for nobody.
  new IntersectionObserver((es) => {
    for (const e of es) { if (e.isIntersecting) schedule(); else clearTimeout(timer); }
  }).observe(journey);
</script>

<style>
  .journey-hero { padding: calc(var(--header-h) + 2.5rem) 0 2.5rem; }
  .journey-hero h1 { margin-bottom: .5rem; }
  .journey-hero .eyebrow a { color: inherit; text-decoration: none; }
  .picker { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.2rem 0 0; }
  .pick { padding: .5rem 1rem; border-radius: 999px; border: 1.5px solid rgba(255,255,255,.4); background: transparent; color: var(--white); font: inherit; font-size: .95rem; cursor: pointer; }
  .pick[aria-selected="true"] { background: var(--accent-bright); border-color: var(--accent-bright); color: var(--ink); font-weight: 600; }

  .journey { position: relative; }
  .stations { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr 1.6fr 1.3fr 1fr; gap: 1rem; align-items: start; }
  .station { position: relative; min-height: 9rem; padding: 1rem .9rem 2.2rem; background: var(--white); border: 1.5px solid var(--line); border-radius: var(--radius); text-align: center; transition: border-color .3s, box-shadow .3s, opacity .3s; }
  .station.on { border-color: var(--accent-bright); box-shadow: 0 0 0 3px rgba(232,112,42,.18), 0 12px 30px rgba(20,22,28,.08); }
  .station.done { opacity: .72; }
  .station h3 { margin: .3rem 0 .15rem; font-size: 1.05rem; }
  .st-num { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; margin: 0; border-radius: 50%; background: var(--line); color: var(--ink); font-family: var(--mono); font-size: .8rem; font-weight: 600; transition: background .3s; }
  .station.on .st-num, .station.done .st-num { background: var(--accent-bright); }
  .st-sub { margin: 0; font-family: var(--mono); font-size: .72rem; color: var(--muted); }
  /* The track between stations. */
  .station + .station::before { content: ''; position: absolute; top: 2.2rem; left: -1rem; width: 1rem; height: 2px; background: var(--line); }
  .station.on::before, .station.done::before { background: var(--accent-bright); }

  .branches, .shelves { list-style: none; margin: .5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; text-align: left; }
  .branch { display: flex; justify-content: space-between; gap: .5rem; padding: .4rem .55rem; border-radius: 6px; border: 1px dashed var(--line); font-size: .78rem; color: var(--muted); transition: all .3s; }
  .branch .to { font-family: var(--mono); white-space: nowrap; }
  .branch.lit { border-style: solid; border-color: var(--accent-bright); background: var(--accent-tint); color: var(--ink); font-weight: 600; }
  .shelf { display: flex; flex-direction: column; padding: .45rem .6rem; border-radius: 6px; border: 1px solid var(--line); font-size: .8rem; color: var(--muted); transition: all .3s; }
  .shelf b { color: var(--ink-2); font-size: .85rem; }
  .shelf.lit { border-color: var(--accent-bright); background: var(--accent-tint); color: var(--ink); }
  .shelf.lit b { color: var(--accent); }

  .token { position: absolute; top: 0; left: 0; z-index: 2; max-width: 11rem; padding: .45rem .7rem; border-radius: 8px; background: var(--band); color: var(--white); font-size: .78rem; line-height: 1.3; box-shadow: 0 10px 24px rgba(20,22,28,.3), 0 0 0 2px var(--accent-bright); transition: transform .8s cubic-bezier(.3,.8,.3,1); pointer-events: none; }
  .token.jump { transition: none; }
  :global(html[data-look="dos"]) .pick { border-color: var(--line); }
  :global(html[data-look="dos"]) .pick[aria-selected="true"], :global(html[data-look="dos"]) .station.on .st-num, :global(html[data-look="dos"]) .station.done .st-num { color: #000; text-shadow: none; }
  :global(html[data-look="dos"]) .token { background: #000; color: var(--ink); box-shadow: 0 0 0 2px var(--accent-bright); }
  :global(html[data-look="dos"]) .station.on { box-shadow: 0 0 0 3px rgba(0, 255, 77, .28), 0 12px 30px rgba(0, 0, 0, .35); }

  .caption { margin-top: 1.5rem; padding: 1.1rem 1.25rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .cap-step { margin: 0 0 .3rem; font-family: var(--mono); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .cap-dest { margin-left: .5rem; text-transform: none; letter-spacing: 0; color: var(--ink-2); }
  .cap-text { margin: 0; min-height: 3.2em; }
  .controls { display: flex; align-items: center; gap: .5rem; margin: .9rem 0 0; }
  .controls .btn { padding: .35rem .8rem; }
  .dots { display: inline-flex; gap: .35rem; margin-left: .5rem; }
  .dots i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--line); transition: background .3s; }
  .dots i.on { background: var(--accent-bright); }

  @media (max-width: 60rem) {
    .stations { grid-template-columns: 1fr; gap: 1.4rem; }
    .station { min-height: 0; padding: .9rem 1rem 2.4rem; text-align: left; display: grid; grid-template-columns: auto 1fr; column-gap: .75rem; align-items: center; }
    .station h3 { margin: 0; }
    .st-sub { grid-column: 2; }
    .branches, .shelves { grid-column: 1 / -1; }
    .station + .station::before { top: -1.4rem; left: 1.6rem; width: 2px; height: 1.4rem; }
    .token { max-width: 13rem; }
  }
</style>
