---
import Base from '../../layouts/Base.astro';
import releases from '../../data/homeade-releases.json';
const nice = (d) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="HomeADE release notes" description="What changed in each version of HomeADE, the Mac app FieldADE talks to.">
  <section class="section" style="padding-top: calc(var(--header-h) + 2rem)">
    <div class="wrap">
      <h1>HomeADE release notes</h1>
      <p><a href="/products#homeade">Back to HomeADE</a></p>
      {releases.map((r) => (
        <div class="release">
          <h2>{r.version} <span class="dim">&middot; {nice(r.date)}</span></h2>
          <p class="release-title">{r.title}</p>
          <ul>{r.notes.map((n) => <li>{n}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .release { margin-top: 2rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .release h2 { margin: 0; font-size: 1.25rem; }
  .release h2 .dim { font-weight: 400; color: var(--muted); }
  .release-title { margin: .2rem 0 .5rem; color: var(--ink-2); }
  .release ul { margin: 0; padding-left: 1.15rem; }
  .release li { margin: .3rem 0; }
</style>
